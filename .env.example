# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

NODE_ENV=development

# PostgreSQL (pgvector, pg_bigm 확장 포함 — docker/Dockerfile.postgres 참조)
DATABASE_URL=postgresql://sbnews:sbnews@localhost:5432/sbnews

# Redis (캐시 + BullMQ 큐 + 세션 스토어)
REDIS_URL=redis://localhost:6379

# 세션 쿠키 서명용 시크릿. openssl rand -base64 32 로 생성.
SESSION_SECRET=

# 앱이 실행되는 base URL (세션 쿠키 도메인, 링크 생성 등에 사용)
APP_BASE_URL=http://localhost:3000

# AI Gateway — 최소 하나는 필수. 모델 선택 자체는 ai_models 테이블(관리자 콘솔)에서 관리.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 사내망에서 프록시가 필요한 경우에만 설정 (§15.4 온프레미스 이전 대비)
HTTP_PROXY=
HTTPS_PROXY=
