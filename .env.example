# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 마세요.

NODE_ENV=development

# PostgreSQL (pgvector, pg_bigm 확장 포함 — docker/Dockerfile.postgres 참조)
DATABASE_URL=postgresql://sbnews:sbnews@localhost:5432/sbnews

# Redis (세션 스토어 + 레이트리밋 + 시세 캐시 + daily-pipeline 중복 실행 방지 락)
REDIS_URL=redis://localhost:6379

# 세션 쿠키 서명용 시크릿. openssl rand -base64 32 로 생성.
SESSION_SECRET=

# 앱이 실행되는 base URL (세션 쿠키 도메인, 링크 생성 등에 사용)
APP_BASE_URL=http://localhost:3000

# AI Gateway — 최소 하나는 필수. 모델 선택 자체는 ai_models 테이블(관리자 콘솔)에서 관리.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 사내망에서 프록시가 필요한 경우에만 설정 (§15.4 온프레미스 이전 대비)
HTTP_PROXY=
HTTPS_PROXY=

# Vercel Cron이 /api/cron/daily-pipeline을 호출할 때 쓰는 인증 시크릿.
# openssl rand -base64 32 로 생성. Vercel 환경변수로 등록하면 Vercel이 크론 요청에
# Authorization: Bearer <값> 헤더를 자동으로 붙인다.
CRON_SECRET=

# AI 예산 가드(src/server/ai/budget.ts) — 최근 24시간 ai_call_logs 건수 상한.
# 선택값, 미설정 시 기본값 300.
AI_DAILY_CALL_LIMIT=
